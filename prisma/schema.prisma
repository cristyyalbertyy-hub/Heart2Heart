generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Room {
  id        String       @id @default(cuid())
  code      String       @unique
  createdAt DateTime     @default(now())
  members   RoomMember[]
  messages  Message[]
}

model RoomMember {
  id          String    @id @default(cuid())
  roomId      String
  room        Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
  displayName String
  nameKey     String
  pinHash     String
  avatarId    String    @default("vermelho")
  createdAt   DateTime  @default(now())
  messages    Message[]

  @@unique([roomId, nameKey])
  @@index([roomId])
}

model Message {
  id        String     @id @default(cuid())
  content   String
  roomId    String
  room      Room       @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId  String
  sender    RoomMember @relation(fields: [senderId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([roomId, createdAt])
}
